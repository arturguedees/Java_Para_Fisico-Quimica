# ==============================================================================
# ARQUIVO DE EXEMPLO DE VARIAVEIS DE AMBIENTE (.env.example)
# ==============================================================================
# Eu criei esse arquivo de exemplo pq o .env de verdade fica no .gitignore por
# questoes de seguranca (pra nao subir senha pro GitHub).
# Para rodar localmente, basta copiar este arquivo para ".env" ou ".env.local".

# Porta onde o servidor Spring Boot vai rodar (o padrao e 8080)
PORT=8080

# Perfil do Spring Boot:
# Use "h2" pra rodar direto sem precisar instalar Postgres/Docker,
# ou deixe em branco (padrao) se estiver com o container do Docker Compose ligado.
SPRING_PROFILES_ACTIVE=h2

# Seguranca: mantemos o painel visual do banco H2 desligado por padrao pra ninguem
# de fora conseguir acessar as tabelas em producao
H2_CONSOLE_ENABLED=false

# Configuracoes do PostgreSQL (usadas quando for rodar com o docker-compose.yml)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/fisico_quimica
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=adminpassword
SPRING_JPA_SHOW_SQL=false

# URL da API para o Frontend React (no PC local usamos localhost:8080,
# e em producao na nuvem ele aponta para https://lab-quantico-fisico-quimica-api.onrender.com)
VITE_API_URL=http://localhost:8080
